FROM apache/apisix:3.14.1-debian@sha256:c228717165ecf4c0055818c9e2d9843f7b303f17a6df9e5fbaf8eafeb5007ae4
USER root
COPY --chown=apisix:apisix work/openresty-1.27.1.2/bundle/nginx-1.27.1/objs/nginx /usr/local/openresty/nginx/sbin/nginx
COPY --chown=apisix:apisix work/openresty-1.27.1.2/bundle/lua-resty-core-0.1.31/lib/ /usr/local/openresty/lualib/
COPY --chown=apisix:apisix current-apisix/ /usr/local/apisix/apisix/
COPY --chown=apisix:apisix runtime-deps/resty/ /usr/local/apisix/deps/share/lua/5.1/resty/
COPY --chown=apisix:apisix demo/ /demo/
COPY --chown=apisix:apisix demo/config.yaml /usr/local/apisix/conf/config.yaml
COPY --chown=apisix:apisix demo/routes.yaml /usr/local/apisix/conf/apisix.yaml
ENV APISIX_STAND_ALONE=true
USER apisix
CMD ["docker-start"]
