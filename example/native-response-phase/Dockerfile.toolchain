FROM apache/apisix:3.14.1-debian@sha256:c228717165ecf4c0055818c9e2d9843f7b303f17a6df9e5fbaf8eafeb5007ae4 AS runtime
FROM gcc:10-bullseye@sha256:19b31d0b2b263047b173e4e253d91f199d99c082973f13604d2913252c13309e
# Match the runtime's libc/toolchain family; reuse its LuaJIT/OpenSSL/PCRE.
# There are no networked RUN steps or dependency upgrades in this build.
COPY --from=runtime /usr/local/openresty/ /usr/local/openresty/
